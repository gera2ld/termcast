[Unit]
Description=TermCast web terminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/termcast serve
Environment=DATA_DIR=%h/.local/share/termcast
Environment=HOST=0.0.0.0
Environment=PORT=9998
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
