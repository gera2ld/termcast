{
  "name": "termcast-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,svelte}": [
      "oxlint --fix",
